{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexanderwebber.com/schemas/cv/timeline.schema.json",
  "title": "CvTimeline",
  "description": "data/cv/timeline.yaml: the timeline's themes (lanes), threads, roles (hats), changes and next items (specs/004-interactive-cv/data-model.md). Written by scripts/import-cv.ts from approved text only. References, one-change threads, budgets and months outside the as_of year are checked by validate.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "themes",
    "threads",
    "roles",
    "changes",
    "next"
  ],
  "properties": {
    "themes": {
      "description": "In page order. At least one, at most eight.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "x-error": "must list one to eight themes",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "line",
          "colour",
          "approved"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "$ref": "#/$defs/line"
          },
          "line": {
            "description": "One sentence on what the theme covers.",
            "$ref": "#/$defs/line"
          },
          "colour": {
            "description": "A token from the section's palette, so contrast is checked once.",
            "enum": [
              "lane-1",
              "lane-2",
              "lane-3",
              "lane-4",
              "lane-5",
              "lane-6",
              "lane-7",
              "lane-8"
            ],
            "x-error": "is not a lane colour (expected lane-1 to lane-8)"
          },
          "approved": {
            "$ref": "#/$defs/approval"
          }
        }
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "line",
          "approved"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "$ref": "#/$defs/line"
          },
          "line": {
            "$ref": "#/$defs/line"
          },
          "approved": {
            "$ref": "#/$defs/approval"
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "when",
          "card",
          "approved"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/line"
          },
          "when": {
            "$ref": "#/$defs/when"
          },
          "card": {
            "$ref": "#/$defs/line"
          },
          "approved": {
            "$ref": "#/$defs/approval"
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "x-error": "must list at least one change",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "when",
          "theme",
          "card",
          "approved"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/line"
          },
          "when": {
            "$ref": "#/$defs/when"
          },
          "theme": {
            "description": "The id of a theme.",
            "$ref": "#/$defs/id"
          },
          "thread": {
            "description": "The id of a thread.",
            "$ref": "#/$defs/id"
          },
          "value": {
            "description": "The id of a value story, marking the change as adding value.",
            "$ref": "#/$defs/id"
          },
          "card": {
            "$ref": "#/$defs/line"
          },
          "approved": {
            "$ref": "#/$defs/approval"
          }
        }
      }
    },
    "next": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "card",
          "approved"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "$ref": "#/$defs/line"
          },
          "card": {
            "$ref": "#/$defs/line"
          },
          "approved": {
            "$ref": "#/$defs/approval"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "description": "Lower-case letters, digits and single hyphens, stable across imports.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80,
      "x-error": "is not an id (lower-case letters, digits and single hyphens)"
    },
    "line": {
      "description": "Plain text on one line, with no leading or trailing spaces.",
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[^\\n\\r]*\\S)?$",
      "x-error": "must be one line of text, not empty and not starting or ending with spaces"
    },
    "when": {
      "description": "A year (2014), a rough year (~2014), years with an en dash (2013–2016), ongoing (2013–now), a month (2026 Oct), months (2026 Feb–May) or into the latest year (2025–2026 Mar). Months only in the as_of year, and start before end, are checked by validate.ts.",
      "type": "string",
      "pattern": "^(?:~\\d{4}|\\d{4}(?:–(?:\\d{4}(?: (?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec))?|now))?|\\d{4} (?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)(?:–(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec))?)$",
      "x-error": "is not a date form (expected 2014, ~2014, 2013–2016, 2013–now, 2026 Oct, 2026 Feb–May or 2025–2026 Mar, with an en dash)"
    },
    "approval": {
      "description": "The owner's approval of an item, written by scripts/import-cv.ts: the day approved in the career record, that record's commit, and the sha256 of the canonical JSON of the item's hashed fields (contracts/content-files.md, Hashed fields). Shared by the CV's other schemas: a reference to another file keeps gen-types from exporting the same name twice.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "source",
        "sha256"
      ],
      "x-error": "has no approval",
      "properties": {
        "date": {
          "$ref": "../defs.schema.json#/$defs/date"
        },
        "source": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "x-error": "is not a commit (7 to 40 lower-case hexadecimal characters)"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "x-error": "is not a sha256 (64 lower-case hexadecimal characters)"
        }
      }
    }
  }
}
