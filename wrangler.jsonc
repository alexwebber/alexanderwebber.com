{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alexanderwebber",
  "main": "src/worker/freshness.ts",
  "compatibility_date": "2026-10-12",
  // Static assets serve first; the Worker only handles /running/api/* (GET /running/api/freshness
  // and /running/api/fundraising-freshness).
  // An address with no page gets dist/404.html (src/pages/404.astro) with a 404 status.
  // `run_worker_first` sends the API path straight to the Worker: with `not_found_handling` set,
  // a browser navigation to an address with no asset would otherwise get the 404 page and never
  // reach the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/running/api/*"]
  },
  // The live site. Deploy creates both hostnames' DNS records. www is redirected to the apex by
  // the zone's "Redirect from WWW to root" rule (dashboard), which runs before the Worker; the custom
  // domain keeps www serving the site if that rule is ever lost.
  "routes": [
    { "pattern": "alexanderwebber.com", "custom_domain": true },
    { "pattern": "www.alexanderwebber.com", "custom_domain": true }
  ],
  // Kept as a fallback address. Every page's canonical URL is the custom domain, so search
  // engines don't index it as a second copy.
  "workers_dev": true,
  // Dispatches refresh.yml on main every 2 hours (src/worker/refresh-trigger.ts). The token is
  // the secret GITHUB_DISPATCH_TOKEN (`npx wrangler secret put`), never a var.
  "triggers": {
    "crons": ["17 */2 * * *"]
  },
  // Keeps the Worker's log lines (e.g. refresh_dispatch_failed) for the dashboard's Logs view.
  "observability": {
    "enabled": true
  },
  "vars": {
    "REFRESH_REPO": "alexwebber/alexanderwebber.com",
    "REFRESH_WORKFLOW": "refresh.yml"
  },
  // The Worker reads only public/freshness.json and public/fundraising-freshness.json from the
  // private bucket.
  "r2_buckets": [
    {
      "binding": "FRESHNESS",
      "bucket_name": "alexanderwebber-private"
    }
  ]
}
