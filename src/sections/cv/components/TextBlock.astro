---
// One approved text block (data-model.md *Text block*): its heading and paragraphs, and for a value
// block its value stories, each at #value-<story-id> (focusable, so a card's value panel leaves focus
// on the story). The block and each story are canonical occurrences for scripts/compare-cv.ts
// (data-cv-item="block:<id>" with heading and paragraphs.0, paragraphs.1 ...; "story:<id>" with
// title and text).
import type { CvBlock } from '../data/store/index.ts';
import { anchor } from './words.ts';

interface Props {
  block: CvBlock;
}

const { block } = Astro.props;
const headingId = `cv-block-${block.id}`;
---

<section class={`cv-block cv-block-${block.kind}`} aria-labelledby={headingId} data-cv-item={`block:${block.id}`}>
  <h2 id={headingId} data-cv-field="heading">{block.heading}</h2>
  {block.paragraphs.map((text, i) => <p data-cv-field={`paragraphs.${i}`}>{text}</p>)}
  {
    block.stories && (
      <div class="cv-stories">
        {block.stories.map((story) => (
          <article class="cv-story" id={anchor.value(story.id)} tabindex="-1" aria-labelledby={`${anchor.value(story.id)}-title`} data-cv-item={`story:${story.id}`}>
            <h3 id={`${anchor.value(story.id)}-title`} data-cv-field="title">
              {story.title}
            </h3>
            <p data-cv-field="text">{story.text}</p>
          </article>
        ))}
      </div>
    )
  }
</section>
