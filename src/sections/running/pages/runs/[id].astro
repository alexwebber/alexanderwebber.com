---
// /running/runs/<run-id>/ (T121, US3; contracts/routes.md, FR-047): everything recorded for one
// run. In order: the Race and Treadmill labels and the owner's note; the headline figures
// (RunSummary); the run's charts against distance, or elapsed time at the flick of a CSS-only
// switch (RunSeriesCharts); Garmin's heart-rate zones (HrZones); per-km splits (SplitsTable);
// the best efforts inside the run (RunBestEfforts); running dynamics and power (RunDynamics).
// Each panel is left out when its data wasn't recorded (FR-048, US3.4).
//
// Privacy (FR-011, FR-013, Principle VI): the date only, never a start time or time of day; no
// map, route or location (race maps belong to race pages, US4); the title is the published one
// (neutral, or the owner's), never the provider's free text; the URL holds the opaque public run
// ID only. Treadmill runs carry the "Treadmill" label (FR-058). Every run page shares one generic
// share image (/og/running-run.png), so no run data goes into an image and the file count stays
// bounded. Garmin attribution names the run's own watch (FR-077). A race's "Race" label links to
// its race page (US4), which adds the map and photos. No client JS beyond the freshness script.
import type { GetStaticPaths } from 'astro';
import { formatDate } from '../../../../shared/format/dates.ts';
import { formatDuration, formatKm } from '../../../../shared/format/units.ts';
import HrZones from '../../components/HrZones.astro';
import RunBestEfforts from '../../components/RunBestEfforts.astro';
import RunDynamics from '../../components/RunDynamics.astro';
import RunSeriesCharts from '../../components/RunSeriesCharts.astro';
import RunSummary from '../../components/RunSummary.astro';
import SectionLayout from '../../components/SectionLayout.astro';
import SplitsTable from '../../components/SplitsTable.astro';
import TreadmillBadge from '../../components/TreadmillBadge.astro';
import { runningStore } from '../../data/load.ts';
import { loadRaces } from '../../data/races.ts';
import type { Run } from '../../data/store/index.ts';
import { formatPace } from '../../domain/pace.ts';
import { raceHref } from '../../links.ts';

export const getStaticPaths = (async () => {
  const [runs, { slugByRun }] = await Promise.all([runningStore().listRuns(), loadRaces()]);
  return runs.map((run) => {
    const slug = slugByRun.get(run.id);
    return { params: { id: run.id }, props: { run, ...(slug !== undefined ? { raceSlug: slug } : {}) } };
  });
}) satisfies GetStaticPaths;

interface Props {
  run: Run;
  /** The race page's slug, for a race (US4). */
  raceSlug?: string;
}

const { run, raceSlug } = Astro.props;
const raceUrl = raceSlug === undefined ? undefined : raceHref(raceSlug);
const date = formatDate(run.date);
const year = run.date.slice(0, 4);
const description =
  `${run.treadmill ? 'A treadmill run' : run.is_race ? 'A race' : 'A run'} by Alexander Webber on ${date}: ` +
  `${formatKm(run.distance_m)} in ${formatDuration(run.moving_s)} (${formatPace(run.avg_pace_s_per_km)}).`;
---

<SectionLayout
  heading={run.title}
  title={`${run.title}, ${date} · Running · Alexander Webber`}
  description={description}
  image="/og/running-run.png"
  imageAlt="Alexander Webber's running"
  garmin={{ device: run.device }}
  current="/running/training/"
>
  <p class="breadcrumb"><a href={`/running/training/${year}/`}>Runs in {year}</a></p>
  <article class="run-detail" aria-label="Run detail" data-run-id={run.id}>
    {
      (run.treadmill || run.is_race) && (
        <p class="run-labels">
          {run.treadmill && <TreadmillBadge />}
          {run.treadmill && run.is_race && ' '}
          {run.is_race &&
            (raceUrl ? (
              <a class="race-label" href={raceUrl} data-race-link>
                Race: see the race page
              </a>
            ) : (
              <span class="race-label">Race</span>
            ))}
        </p>
      )
    }
    {run.note && <p class="run-note" data-run-note>{run.note}</p>}
    <RunSummary run={run} />
    <RunSeriesCharts run={run} />
    <HrZones run={run} />
    <SplitsTable run={run} />
    <RunBestEfforts run={run} />
    <RunDynamics run={run} />
  </article>
</SectionLayout>

<style>
  .run-labels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
  }

  .race-label {
    padding: 0 var(--space-2);
    border: 1px solid currentColor;
    border-radius: var(--radius-mark);
    color: var(--color-accent-strong);
    font-size: var(--step--1);
    font-weight: var(--weight-bold);
    line-height: 1.6;
  }

  .run-note {
    margin: 0 0 var(--space-5);
  }
</style>
