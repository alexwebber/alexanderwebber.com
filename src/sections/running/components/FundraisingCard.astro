---
// The fundraising card in the hero's "fundraising" slot (T051, T096; FR-030, FR-031, FR-033, FR-034, FR-062;
// specs/002-fundraising/contracts/routes.md): the total against the target, the bar, the supporters
// and charity, Donate, when the figures were last read, and a link to the fundraising page (T071,
// FR-040), which always exists when this renders, because both need a campaign with figures. It
// looks like a goal card but isn't one (FR-025): it has its own class, and its target never joins
// the Goals page or the featured goals. The page renders it only with a current campaign with
// figures, so without one the slot holds nothing at all. After race day FundraisingFigures takes the
// "Raised £X" form by itself; a finished campaign has no updated line and no stale notice, because
// it is no longer read (FR-023). Every figure is in the built HTML, and the only client JS is
// FundraisingUpdated's.
//
// The charity's logo, when the campaign has one (T116), sits at the bottom right, beside the updated
// line and the page link: Donate has almost no room to spare on a phone's first screen, so nothing is
// added above it.
//
// To keep Donate on a 360 x 640 phone's first screen (owner, 2026-11-06), the card's "Fundraising"
// heading is there for screen readers only (the accent edge and the total say what the card is),
// and Donate comes straight after the total, before the bar (FundraisingFigures' donateFirst).
import type { CampaignView } from '../data/fundraising.ts';
import type { CharityLogo as Logo } from '../data/logos.ts';
import CharityLogo from './CharityLogo.astro';
import FundraisingFigures from './FundraisingFigures.astro';
import FundraisingUpdated from './FundraisingUpdated.astro';
import '../styles/goal-card.css';

export interface Props {
  campaign: CampaignView;
  /** The charity's logo, from charityLogo(). */
  logo?: Logo | undefined;
  /** The build time; tests and previews pin it. */
  now?: Date;
}

const { campaign, logo, now } = Astro.props;
const id = `fundraising-${campaign.campaign.id}`;
---

<article class="fundraising-card" aria-labelledby={id} data-campaign-id={campaign.campaign.id}>
  <h3 class="fundraising-card-title visually-hidden" id={id}>Fundraising</h3>
  <FundraisingFigures campaign={campaign} donateFirst />
  <div class="fundraising-card-foot">
    <div>
      {campaign.phase !== 'finished' && <FundraisingUpdated campaignId={campaign.campaign.id} lastReadAt={campaign.lastReadAt} staleAfterHours={campaign.staleAfterHours} {...now ? { now } : {}} />}
      <p class="fundraising-card-more"><a href="/running/fundraising/">See the fundraising page</a></p>
    </div>
    {logo && <CharityLogo logo={logo} width={64} />}
  </div>
</article>

<style>
  .fundraising-card-foot {
    display: flex;
    gap: var(--space-3);
    align-items: flex-end;
    justify-content: space-between;
  }

  .fundraising-card-foot > :global(.charity-logo) {
    margin-top: var(--space-3);
  }

  .fundraising-card-more {
    margin: var(--space-2) 0 0;
    font-size: var(--step--1);
  }
</style>
