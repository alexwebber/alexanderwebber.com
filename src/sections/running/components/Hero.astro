---
// The focus-race hero that leads the landing page (T098; FR-020, FR-021, FR-025, US1.1, US1.2):
// - "Brighton Marathon · 4 April 2027";
// - days remaining (Countdown), "Race day", "Result coming soon", or the result once recorded;
// - "Target: sub-3:25" from the upcoming race's target_time, so a tightened target shows here
//   with no other change (US1.2);
// - the owner's latest Garmin prediction at the race distance "as of" its date (AsOf), or nothing
//   when none is recorded;
// - "For Martlets hospice" as plain text;
// - a reserved place for the fundraising feature (FR-025): the named slot "fundraising", which
//   nothing fills yet, so nothing is shown;
// - the training build chart (TrainingBuild).
// Garmin attribution sits under the heading when the hero shows a Garmin prediction, and at the
// chart's title for the runs behind the build (FR-077). No client JS beyond Countdown's.
import { formatLongDate } from '../../../shared/format/dates.ts';
import { formatDuration } from '../../../shared/format/units.ts';
import type { FocusRaceView } from '../data/landing.ts';
import AsOf from './AsOf.astro';
import Countdown from './Countdown.astro';
import GarminAttribution from './GarminAttribution.astro';
import TrainingBuild from './TrainingBuild.astro';

export interface Props {
  focus: FocusRaceView;
  /** Europe/London YYYY-MM-DD (the build day). */
  today: string;
}

const { focus, today } = Astro.props;
const { race, state, prediction, result } = focus;
---

<section class="hero" aria-labelledby="hero-title" data-hero data-race-state={state}>
  <div class="hero-main">
    <p class="hero-eyebrow">Focus race</p>
    <h2 class="hero-title" id="hero-title">
      {race.name} <span class="hero-date">· {formatLongDate(race.date)}</span>
    </h2>
    {prediction && <GarminAttribution />}
    {
      state === 'completed' ? (
        <p class="hero-result" data-result>
          {result?.time_s !== undefined ? (
            <>
              Finished in <strong>{formatDuration(result.time_s)}</strong>
              {result.official ? ' (official time)' : ''}
            </>
          ) : (
            <strong>Finished</strong>
          )}
        </p>
      ) : (
        <Countdown date={race.date} days={focus.days} />
      )
    }
    <ul class="hero-facts">
      {
        focus.target && (
          <li data-target>
            Target: <strong>{focus.target}</strong>
          </li>
        )
      }
      {
        prediction && (
          <li data-prediction>
            <AsOf label="Garmin predicts" value={prediction.time} asOf={prediction.as_of} />
          </li>
        )
      }
      <li data-charity>For {focus.charity}</li>
    </ul>
    <slot name="fundraising" />
  </div>
  <div class="hero-build">
    <TrainingBuild build={focus.build} today={today} heading={3} />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-top: 6px solid var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: start;
      padding: var(--space-5);
    }
  }

  .hero-eyebrow {
    margin: 0 0 var(--space-1);
    color: var(--color-accent-strong);
    font-size: var(--step--1);
    font-weight: var(--weight-bold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-title {
    margin: 0 0 var(--space-1);
    font-size: var(--step-2);
    line-height: var(--leading-tight);
  }

  .hero-date {
    white-space: nowrap;
  }

  .hero-main :global(.countdown) {
    margin-top: var(--space-3);
  }

  .hero-result {
    margin: var(--space-3) 0 0;
    font-size: var(--step-2);
  }

  .hero-facts {
    display: grid;
    gap: var(--space-1);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  [data-target] {
    font-size: var(--step-1);
  }

  .hero-build :global(.chart-figure) {
    padding: 0;
    border: 0;
  }

  @media (forced-colors: active) {
    .hero {
      border-top-color: Highlight;
    }
  }
</style>
