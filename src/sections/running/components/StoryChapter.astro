---
// One chapter of the journey story (spec 003; contracts/routes.md *The page*), in order: its name
// (an unnumbered <h2>, FR-003), when (one <time>, or two for a period), the prose with its figures,
// the place photos will take (Phase 5), the one place reserved for a future video (FR-053, SC-013),
// then the "What I learned" box (FR-004). A chapter with no figures or photos renders no empty
// wrapper for them (US1.4). Its ID is its anchor (`#<id>`), stable for the chapter's life (FR-051).
import type { ChapterView } from '../data/journey.ts';
import StoryProse from './StoryProse.astro';

export interface Props {
  chapter: ChapterView;
}

const { chapter } = Astro.props;
---

<section class="story-chapter" id={chapter.id} aria-labelledby={`${chapter.id}-title`}>
  <h2 id={`${chapter.id}-title`}>{chapter.name}</h2>
  <p class="story-when">{chapter.when.map((part, i) => <Fragment>{i > 0 && ' to '}<time datetime={part.datetime}>{part.text}</time></Fragment>)}</p>
  <StoryProse paragraphs={chapter.paragraphs} figures={chapter.figures} chapterId={chapter.id} />
  {/* Photos go here (Phase 5). */}
  {/* ChapterVideo goes here, once a later spec approves a chapter's video (FR-053, SC-013): the one reserved place, rendering nothing until then. */}
  <div class="story-takeaway">
    <h3 id={`${chapter.id}-learned`}>What I learned</h3>
    <p>{chapter.takeaway}</p>
  </div>
</section>
