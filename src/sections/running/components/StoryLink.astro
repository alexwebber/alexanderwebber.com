---
// The link to Alex's personal story (T100; FR-024, US1.6). It appears only once section.yaml has
// `story_link`; until then nothing renders: no link, no placeholder. Adding the link needs no other
// change to the landing page. No client JS.
//
// The story page now exists in code (spec 003: pages/story.astro, built once a chapter exists), and
// this panel is its landing link, unchanged (FR-040). validate-data holds the setting to it:
// `href` must be /running/story/, the setting is refused while no chapter exists, and `label` must
// equal page.yaml's approved `link_label` (data-model.md §9). SectionLinks then leaves "Story" out
// of the links below, as this panel already leads there.
import { sectionSettings } from '../data/load.ts';

const { story_link: link } = await sectionSettings();
---

{
  link && (
    <p class="story-link" data-story-link>
      <a href={link.href}>{link.label}</a>
    </p>
  )
}

<style>
  .story-link {
    margin: 0 0 var(--space-6);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-left: 6px solid var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-surface);
    font-size: var(--step-1);
    font-weight: var(--weight-bold);
  }

  .story-link a {
    display: inline-block;
    min-height: 1.5rem;
  }
</style>
