---
// The link to Alex's personal story (T100; FR-024, US1.6). It appears only once section.yaml has
// `story_link` (the story page is a separate, future spec); until then nothing renders: no link,
// no placeholder. Adding the link needs no other change to the landing page. No client JS.
import { sectionSettings } from '../data/load.ts';

const { story_link: link } = await sectionSettings();
---

{
  link && (
    <p class="story-link" data-story-link>
      <a href={link.href}>{link.label}</a>
    </p>
  )
}

<style>
  .story-link {
    margin: 0 0 var(--space-6);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-left: 6px solid var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-surface);
    font-size: var(--step-1);
    font-weight: var(--weight-bold);
  }

  .story-link a {
    display: inline-block;
    min-height: 1.5rem;
  }
</style>
