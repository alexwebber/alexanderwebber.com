---
// An active goal (T090; FR-032, FR-038, FR-039, FR-041): its target, where Alex is now, a progress
// bar with the same figures in words, the time left to its deadline (or "deadline passed"), and
// for race-time goals the fastest effort (linked to its run once run pages exist) and the owner's
// latest Garmin prediction "as of" its date (nothing when there is no entry). With nothing to
// measure yet it says "No data yet" rather than showing 0%. Garmin attribution sits under the
// card's heading whenever the card shows Garmin data (T152). No client JS.
//
// `compact` (the landing page's featured goals, T101) keeps what FR-022 asks for in less height:
// how far is left in words ("3:00 to go", "8.6 kg to go"), the current value and the target, the
// Garmin prediction, the progress bar with its figures, and the time left to the deadline.
import ProgressBar from '../../../shared/charts/ProgressBar.astro';
import { formatDate } from '../../../shared/format/dates.ts';
import { formatDuration } from '../../../shared/format/units.ts';
import { goalAttribution } from '../domain/attribution.ts';
import { deadlineText, distanceLabel, formatMetric, gapText, metricName, progressText, targetText, toGoText } from '../domain/goal-text.ts';
import type { GoalEvaluation } from '../domain/goals.ts';
import { runHref } from '../links.ts';
import AsOf from './AsOf.astro';
import GarminAttribution from './GarminAttribution.astro';

export interface Props {
  evaluation: GoalEvaluation;
  /** The card title's heading level (3 under a page's h2 sections). */
  heading?: 2 | 3 | 4;
  /** The landing page's shorter card. */
  compact?: boolean;
}

const { evaluation: e, heading = 3, compact = false } = Astro.props;
const { goal } = e;
const Heading = `h${heading}` as const;
const id = `goal-${goal.id}`;
const attribution = goalAttribution(e);
const target = targetText(e);
const race = e.linkedRace;
const deadlineIsRaceDay = race && goal.deadline === race.date;
const progress = e.kind === 'milestone' ? undefined : progressText(e);
const fastestHref = e.kind === 'race_time' && e.fastest?.run_id ? runHref(e.fastest.run_id) : undefined;
// Compact: the headline (how far is left) and the line under it (now and the target).
const headline = e.kind === 'race_time' ? gapText(e) : e.kind === 'value' ? toGoText(e) : undefined;
// The title names the distance or metric, so the compact target is just the figure.
const shortTarget = e.kind === 'race_time' ? formatDuration(e.target_s) : e.kind === 'value' ? formatMetric(e.metric, e.target) : undefined;
const deadlineLine =
  goal.deadline && e.daysToDeadline !== undefined
    ? `${deadlineIsRaceDay ? 'Race day' : 'Deadline'} ${formatDate(goal.deadline)} · ${deadlineText(e.daysToDeadline)}`
    : undefined;
// " on 9 Oct 2026 (Brighton 10k), 3:00 to go", or " on 3 Oct 2026 (in a longer run), 3:00 to go"
const fastestNote = e.kind === 'race_time' && e.fastest ? (e.fastest.race?.name ?? (e.fastest.inLongerRun ? 'in a longer run' : undefined)) : undefined;
const fastestSuffix =
  e.kind === 'race_time' && e.fastest ? ` on ${formatDate(e.fastest.date)}${fastestNote ? ` (${fastestNote})` : ''}, ${gapText(e)}` : '';
---

<article class="goal-card" aria-labelledby={id} data-goal-id={goal.id} data-priority={goal.priority} data-status={e.status}>
  <header class="goal-card-header">
    <Heading class="goal-card-title" id={id}>{goal.title}</Heading>
    {attribution && <GarminAttribution {...attribution} />}
  </header>
  {
    e.status === 'deadline_passed' && (
      <p class="goal-flag" data-deadline-passed>
        Deadline passed
      </p>
    )
  }
  {
    compact && (
      <div class="goal-compact" data-compact>
        {e.kind !== 'milestone' && (
          <p class="goal-headline" data-headline data-no-data={headline ? undefined : ''}>
            {headline ?? (e.kind === 'race_time' ? `No ${distanceLabel(e.distance_m)} effort yet` : 'No data yet')}
          </p>
        )}
        {e.kind !== 'milestone' && (
          <p class="goal-now">
            {e.kind === 'race_time' && e.fastest && (
              <span data-fastest>
                Fastest {fastestHref ? <a href={fastestHref}>{formatDuration(e.fastest.time_s)}</a> : <strong>{formatDuration(e.fastest.time_s)}</strong>}
                {e.fastest.inLongerRun && <> (in a longer run)</>} ·{' '}
              </span>
            )}
            {e.kind === 'value' && e.latest && (
              <span data-current>
                Now <strong>{formatMetric(e.metric, e.latest.value, true)}</strong>
                {e.metric === 'weight_kg' ? ' (7-day average)' : ''} ·{' '}
              </span>
            )}
            <span data-target>Target {shortTarget}</span>
          </p>
        )}
        {e.kind === 'race_time' && e.prediction && (
          <p class="goal-prediction" data-prediction>
            <AsOf label="Garmin:" value={e.prediction.time} after="if raced today" asOf={e.prediction.as_of} />
          </p>
        )}
      </div>
    )
  }
  {!compact && goal.description && <p class="goal-description">{goal.description}</p>}
  {!compact && (
  <dl class="goal-facts">
    {
      target && (
        <div>
          <dt>Target</dt>
          <dd>{target}</dd>
        </div>
      )
    }
    {
      e.kind === 'race_time' && (
        <div>
          <dt>Fastest {distanceLabel(e.distance_m)}</dt>
          <dd data-fastest data-no-data={e.fastest ? undefined : ''}>
            {e.fastest ? (
              <>
                {fastestHref ? <a href={fastestHref}>{formatDuration(e.fastest.time_s)}</a> : <strong>{formatDuration(e.fastest.time_s)}</strong>}{fastestSuffix}
              </>
            ) : (
              'No data yet'
            )}
          </dd>
        </div>
      )
    }
    {
      e.kind === 'race_time' && e.prediction && (
        <div>
          <dt>Garmin race predictor</dt>
          <dd data-prediction>
            <AsOf value={e.prediction.time} after="if raced today" asOf={e.prediction.as_of} />
          </dd>
        </div>
      )
    }
    {
      e.kind === 'value' && (
        <div>
          <dt>{e.metric === 'weight_kg' ? 'Weight (7-day average)' : metricName(e.metric)}</dt>
          <dd data-current data-no-data={e.latest ? undefined : ''}>
            {e.latest ? (
              <>
                <strong>{formatMetric(e.metric, e.latest.value, true)}</strong> on {formatDate(e.latest.date)}
              </>
            ) : (
              'No data yet'
            )}
          </dd>
        </div>
      )
    }
    {
      e.kind === 'value' && e.start !== undefined && e.latest && (
        <div>
          <dt>Start</dt>
          <dd>{formatMetric(e.metric, e.start, true)}</dd>
        </div>
      )
    }
    {
      race && (
        <div>
          <dt>{deadlineIsRaceDay ? 'Race day' : 'Race'}</dt>
          <dd>
            {race.name}, {formatDate(race.date)}
            {deadlineIsRaceDay && e.daysToDeadline !== undefined && <> · {deadlineText(e.daysToDeadline)}</>}
          </dd>
        </div>
      )
    }
    {
      goal.deadline && !deadlineIsRaceDay && e.daysToDeadline !== undefined && (
        <div>
          <dt>Deadline</dt>
          <dd>
            {formatDate(goal.deadline)} · {deadlineText(e.daysToDeadline)}
          </dd>
        </div>
      )
    }
  </dl>
  )}
  {
    e.kind !== 'milestone' &&
      e.fraction !== undefined &&
      progress && (
        <div class="goal-progress">
          <ProgressBar label={`${goal.title}: progress`} fraction={e.fraction} valueText={progress} color="var(--running-series)" />
          {!compact && <p class="goal-progress-text">{progress}</p>}
        </div>
      )
  }
  {compact && deadlineLine && <p class="goal-deadline" data-deadline>{deadlineLine}</p>}
</article>

<style>
  .goal-card {
    height: 100%;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .goal-card-header {
    margin-bottom: var(--space-3);
  }

  .goal-card-title {
    margin: 0;
    font-size: var(--step-1);
    line-height: var(--leading-tight);
  }

  .goal-flag {
    display: inline-block;
    margin: 0 0 var(--space-3);
    padding: var(--space-1) var(--space-2);
    border-left: 4px solid var(--color-notice-border);
    border-radius: var(--radius-mark);
    background: var(--color-notice-bg);
    color: var(--color-notice-text);
    font-size: var(--step--1);
    font-weight: var(--weight-bold);
  }

  .goal-description {
    margin: 0 0 var(--space-3);
    color: var(--color-text-secondary);
  }

  .goal-facts {
    display: grid;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
  }

  .goal-facts div {
    display: grid;
    gap: 0 var(--space-3);
  }

  @media (min-width: 30rem) {
    .goal-facts div {
      grid-template-columns: 9rem 1fr;
    }
  }

  .goal-facts dt {
    color: var(--color-text-secondary);
    font-size: var(--step--1);
  }

  .goal-facts dd {
    margin: 0;
  }

  .goal-headline {
    margin: 0;
    font-size: var(--step-2);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    color: var(--color-accent-strong);
  }

  .goal-headline[data-no-data] {
    font-size: var(--step-1);
    color: var(--color-text-secondary);
  }

  .goal-now,
  .goal-prediction {
    margin: var(--space-1) 0 0;
  }

  .goal-compact {
    margin-bottom: var(--space-3);
  }

  .goal-deadline {
    margin: var(--space-2) 0 0;
    font-size: var(--step--1);
    color: var(--color-text-secondary);
  }

  .goal-progress :global(.progress) {
    margin-bottom: var(--space-2);
  }

  .goal-progress-text {
    margin: 0;
    font-size: var(--step--1);
    color: var(--color-text-secondary);
  }
</style>
