---
// "Last updated" and the stale-data notice (T076; FR-005/006/074; contracts/pipeline.md
// "Freshness endpoint").
//
// Without JS it shows the last successful fetch known at build time (refresh.json), and the stale
// notice if that was already older than stale_after_hours when the site was built (the daily
// rebuild keeps this honest). A small script then asks /running/api/freshness for the live value
// (refreshes that find nothing new make no commit, so the build value can lag), shows it as
// "Last updated 2 hours ago" and shows or hides the notice. If the endpoint fails (503 or
// offline), the build-time text and notice stay as they are.
//
// The instant is carried as epoch milliseconds, not an ISO datetime: run pages must not contain
// ISO times of day (scripts/scan-privacy.ts), and this component sits on every Running page.
import { formatDateTime } from '../../../shared/format/dates.ts';

export interface Props {
  /** UTC timestamp of the last successful fetch known at build time; undefined before the first publish. */
  lastSuccessAt: string | undefined;
  staleAfterHours: number;
  /** The build time; tests pin it. */
  now?: Date;
}

const { lastSuccessAt, staleAfterHours, now = new Date() } = Astro.props;
const successMs = lastSuccessAt ? Date.parse(lastSuccessAt) : undefined;
if (successMs !== undefined && !Number.isFinite(successMs)) throw new Error(`LastUpdated: not a timestamp: ${lastSuccessAt}`);
const staleMs = staleAfterHours * 3_600_000;
const staleAtBuild = successMs !== undefined && now.getTime() - successMs > staleMs;
---

<div class="last-updated" data-last-updated data-success-ms={successMs ?? ''} data-stale-ms={staleMs}>
  <p class="last-updated-text" data-last-updated-text>
    {successMs === undefined ? 'Not updated yet' : `Last updated ${formatDateTime(new Date(successMs))}`}
  </p>
  <p class="stale-notice" data-stale-notice hidden={!staleAtBuild}>
    <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16">
      <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
      <path d="M8 4v5M8 11v1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
    <span>These figures may be out of date: the last successful update was more than {staleAfterHours} hours ago.</span>
  </p>
</div>

<script>
  // Under 1 KB minified. Reads the live freshness once per page.
  const blocks = document.querySelectorAll<HTMLElement>('[data-last-updated]');
  const rtf = new Intl.RelativeTimeFormat('en-GB', { numeric: 'auto' });

  function ago(ms: number): string {
    const minutes = Math.round(ms / 60_000);
    if (minutes < 1) return 'just now';
    if (minutes < 60) return rtf.format(-minutes, 'minute');
    const hours = Math.round(minutes / 60);
    return hours < 48 ? rtf.format(-hours, 'hour') : rtf.format(-Math.round(hours / 24), 'day');
  }

  if (blocks.length > 0) {
    fetch('/running/api/freshness', { headers: { Accept: 'application/json' } })
      .then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
      .then((body) => {
        const live = Date.parse(body?.intervals?.last_success_at);
        if (!Number.isFinite(live)) return;
        for (const block of blocks) {
          const success = Math.max(live, Number(block.dataset.successMs) || 0);
          const age = Math.max(0, Date.now() - success);
          block.querySelector('[data-last-updated-text]')!.textContent = `Last updated ${ago(age)}`;
          block.querySelector<HTMLElement>('[data-stale-notice]')!.hidden = age <= Number(block.dataset.staleMs);
        }
      })
      .catch(() => {});
  }
</script>

<style>
  .last-updated {
    margin-bottom: var(--space-5);
    font-size: var(--step--1);
    color: var(--color-text-secondary);
  }

  .last-updated p {
    margin: 0;
  }

  .stale-notice {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    margin-top: var(--space-2) !important;
    padding: var(--space-2) var(--space-3);
    border-left: 4px solid var(--color-notice-border);
    border-radius: var(--radius-mark);
    background: var(--color-notice-bg);
    color: var(--color-notice-text);
  }

  .stale-notice[hidden] {
    display: none;
  }

  .stale-notice svg {
    flex: none;
    margin-top: 0.15em;
  }
</style>
