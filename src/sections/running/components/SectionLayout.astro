---
// The layout every Running page uses (T076): the shared Base shell in Running's warm theme, the
// section nav built from the route registry (integration.ts), the page heading with Garmin
// attribution right under it when the page shows Garmin data (T152, title-level placement), and
// "Last updated" with the stale notice.
//
// Slots: default = page content; "last-updated" replaces the freshness line (rarely needed).
// `lastUpdated={false}` leaves the freshness line out altogether, for a page that isn't a data view
// (the journey story, spec 003 FR-071). A prop rather than an empty slot, because Astro.slots.has
// reports a conditional slot as filled.
import Base from '../../../shared/layout/Base.astro';
import Nav from '../../../shared/layout/Nav.astro';
import { runningAreas } from '../integration.ts';
import { buildFreshness } from '../data/load.ts';
import GarminAttribution from '../components/GarminAttribution.astro';
import LastUpdated from '../components/LastUpdated.astro';
import '../styles/theme.css';

export interface Props {
  /** The page's <h1>. */
  heading: string;
  /** The <title>; defaults to "<heading> · Running · Alexander Webber". */
  title?: string;
  description: string;
  /** Share image path, e.g. /og/running-goals.png. */
  image: string;
  imageAlt: string;
  /** Show Garmin attribution under the heading (any page showing Garmin-sourced data, FR-077). */
  garmin?: boolean | { device?: string | readonly string[]; scale?: boolean; derived?: boolean };
  /** href of the nav item this page sits under (e.g. a run page under Training). */
  current?: string;
  /** Show "Last updated" (default). False only for a page that shows no stored data's freshness. */
  lastUpdated?: boolean;
  /** Hold the heading to the text's 66ch, for a page of prose (the journey story), so on a desktop the
   *  title wraps over the text column instead of spanning the page (owner, 2026-11-07). */
  narrow?: boolean;
}

const { heading, description, image, imageAlt, garmin = false, current, lastUpdated = true, narrow = false } = Astro.props;
const title = Astro.props.title ?? `${heading} · Running · Alexander Webber`;
const nav = runningAreas
  .filter((area) => area.inNav !== false)
  .map((area) => ({ label: area.label, href: area.href }));
const freshness = lastUpdated ? await buildFreshness() : undefined;
const attribution = garmin === true ? {} : garmin || undefined;
---

<Base title={title} description={description} image={image} imageAlt={imageAlt} theme="theme-running">
  <Nav slot="nav" label="Running" items={nav} current={current} />
  <header class:list={['page-header', { 'page-header-narrow': narrow }]}>
    <h1>{heading}</h1>
    {attribution && <GarminAttribution {...attribution} />}
  </header>
  {
    freshness && (
      <slot name="last-updated">
        <LastUpdated lastSuccessAt={freshness.lastSuccessAt} staleAfterHours={freshness.staleAfterHours} />
      </slot>
    )
  }
  <slot />
</Base>

<style>
  /* Tight, so a phone's first screen reaches the landing page's Donate (owner, 2026-11-06). */
  .page-header {
    margin-bottom: var(--space-1);
  }

  .page-header h1 {
    margin-bottom: 0;
  }

  /* 66ch in the body's font, the same measure as the story's paragraphs (story.css). */
  .page-header-narrow {
    max-width: 66ch;
  }
</style>
