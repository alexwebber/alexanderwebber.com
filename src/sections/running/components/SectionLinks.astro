---
// Links from the landing page to the section's other areas (T100, FR-027): Goals, Training,
// Races, Health and, once a campaign has figures, Fundraising, from the route registry
// (integration.ts). No client JS.
import { runningAreas } from '../integration.ts';

export interface Props {
  heading?: 2 | 3;
}

const { heading = 2 } = Astro.props;
const Heading = `h${heading}` as const;
const areas = runningAreas.filter((area) => area.key !== 'landing' && area.inNav !== false);
---

{
  areas.length > 0 && (
    <nav class="section-links" aria-labelledby="section-links-title" data-section-links>
      <Heading class="section-links-title" id="section-links-title">
        More about Alex's running
      </Heading>
      <ul>
        {areas.map((area) => (
          <li>
            <a href={area.href}>
              <span class="section-link-label">{area.label}</span>
              {area.description && <span class="section-link-description">{area.description}</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .section-links {
    margin-bottom: var(--space-6);
  }

  .section-links-title {
    font-size: var(--step-2);
  }

  ul {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  a {
    display: grid;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    text-decoration: none;
  }

  a:hover .section-link-label {
    text-decoration: underline;
  }

  .section-link-label {
    font-size: var(--step-1);
    font-weight: var(--weight-bold);
  }

  .section-link-description {
    color: var(--color-text-secondary);
  }
</style>
