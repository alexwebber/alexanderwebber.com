---
// A progress meter (T074), e.g. a goal's progress from its start value towards its target. Built
// as an ARIA meter so assistive tech reads the value text; the caller shows the figures in words
// next to it as well. The track is a light step of the fill's own hue, so the state reads across
// the whole bar. No client JS.
export interface Props {
  /** Accessible name, e.g. "Progress to 93 kg". */
  label: string;
  /** 0 to 1; values outside are clamped (an overshoot shows as full). */
  fraction: number;
  /** What a screen reader hears, e.g. "5.2 of 8 kg lost (65%)". */
  valueText: string;
  /** Fill colour; defaults to the page accent. */
  color?: string;
}

const { label, fraction, valueText, color = 'var(--color-accent)' } = Astro.props;
const clamped = Number.isFinite(fraction) ? Math.min(1, Math.max(0, fraction)) : 0;
const percent = Math.round(clamped * 100);
---

<div class="progress" role="meter" aria-label={label} aria-valuemin="0" aria-valuemax="100" aria-valuenow={percent} aria-valuetext={valueText} style={`--progress-color: ${color}`}>
  <span class="progress-fill" style={`width: ${clamped * 100}%`}></span>
</div>

<style>
  .progress {
    position: relative;
    height: 0.75rem;
    margin-bottom: var(--space-4);
    border-radius: var(--radius-mark);
    background: color-mix(in srgb, var(--progress-color) 18%, var(--color-surface));
    overflow: hidden;
  }

  .progress-fill {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: var(--radius-mark);
    background: var(--progress-color);
  }

  @media (forced-colors: active) {
    .progress {
      border: 1px solid CanvasText;
    }

    .progress-fill {
      background: Highlight;
    }
  }
</style>
