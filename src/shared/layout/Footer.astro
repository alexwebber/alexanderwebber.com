---
// The site footer (T073). Sections add their own lines (e.g. data attribution) through the
// default slot.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <slot />
    <p>&copy; {year} Alexander Webber &middot; <a href="/">Home</a></p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-7);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: var(--step--1);
  }

  .site-footer :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
