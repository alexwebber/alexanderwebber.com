---
// /fundraising-preview/<state>/ (SHELL_PREVIEW=1 only): each synthetic state through the real
// FundraisingPage, with the real FundraisingCard in its default slot when the state has a current
// campaign, for tests/e2e/fundraising.spec.ts and tests/a11y/fundraising.spec.ts.
import type { GetStaticPaths } from 'astro';
import FundraisingCard from '../../../src/sections/running/components/FundraisingCard.astro';
import FundraisingPage from '../../../src/sections/running/components/FundraisingPage.astro';
import { loadFundraising } from '../../../src/sections/running/data/fundraising.ts';
import { PREVIEW_NOW, PREVIEW_STATES, PREVIEW_TODAY, previewStore, type PreviewState } from './store.ts';

export const getStaticPaths = (() => PREVIEW_STATES.map((state) => ({ params: { state }, props: { state } }))) satisfies GetStaticPaths;

interface Props {
  state: PreviewState;
}

const { state } = Astro.props;
const data = await loadFundraising(PREVIEW_TODAY, previewStore(state));
---

<FundraisingPage data={data} image="/og/running.png" title={`Fundraising preview: ${state} (synthetic data)`} now={PREVIEW_NOW}>
  {
    data.current && (
      <section aria-labelledby="preview-card" data-preview-card>
        <h2 id="preview-card">The landing card</h2>
        <FundraisingCard campaign={data.current} now={PREVIEW_NOW} />
      </section>
    )
  }
</FundraisingPage>

<style>
  section {
    margin-bottom: var(--space-6);
  }
</style>
